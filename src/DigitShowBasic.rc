/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON                    "res\\DigitShowBasic.ico"

IDR_DIGITSTYPE          ICON                    "res\\DigitShowBasicDoc.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU
BEGIN
    POPUP "File(&F)"
    BEGIN
        MENUITEM "Close application(&X)",       ID_APP_EXIT
    END
    POPUP "View"
    BEGIN
        MENUITEM "Board Settings",              ID_BoardSettings
        MENUITEM "Sampling Settings",           ID_SamplingSettings
    END
    POPUP "Calibration"
    BEGIN
        MENUITEM "Factors",                     ID_Calibration_Factor
    END
    POPUP "Specimen"
    BEGIN
        MENUITEM "Input",                       ID_SpecimenData
    END
    POPUP "Control"
    BEGIN
        MENUITEM "General",                     ID_Control_General
        MENUITEM "Control_ID",                  ID_Control_ID
        MENUITEM "PreCosolidation",             ID_Control_PreConsolidation
        MENUITEM "Consolidation",               ID_Consolidation
        MENUITEM "Control from the file",       ID_Control_File
    END
    POPUP "D/A_Output"
    BEGIN
        MENUITEM "D/A Channels",                ID_DA_Channel
        MENUITEM "Voltage Output",              ID_DA_Vout
    END
    POPUP "Help(&H)"
    BEGIN
        MENUITEM "DigitShowBasic Ver.(&A)...",  ID_APP_ABOUT
    END
END


